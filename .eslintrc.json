{
  "extends": ["google"],
  "env": {
    "browser": true,
    "node": true,
    "jest": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "require-jsdoc": "off",
    "no-unused-vars": "warn",
    "max-len": ["error", { "code": 120 }],
    "indent": ["error", 2]
  }
}